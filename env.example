# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores
# do seu projeto no painel do Supabase:
# Project Settings > API > Project URL / anon public key
#
# O arquivo ".env" NÃO deve ser enviado ao GitHub (já está no .gitignore).
# No GitHub Pages / GitHub Actions, esses mesmos valores devem ser
# cadastrados como "Secrets" do repositório (veja o guia de deploy).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
